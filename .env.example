CLAUDE_API_KEY=
# Claude — modelo e comportamento (steps roteiro + imagens)
# CLAUDE_MODEL: modelo da API Anthropic (default: claude-opus-4-7)
# CLAUDE_MAX_TOKENS: limite de tokens de saida (default: 16000)
# CLAUDE_THINKING: adaptive (Opus 4.7), disabled (sem thinking, permite temperature), ou vazio (sem thinking)
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=16000
CLAUDE_THINKING=adaptive

# Claude Message Batches API (~50% custo vs sync). Producao: batch; debug local: sync
# GENTUBE_CLAUDE_DELIVERY=batch
# GENTUBE_CLAUDE_BATCH_POLL_INTERVAL=60s
# Logs detalhados no terminal (poll batch, etapas segmentacao/visualizacao). Ou: --verbose no CLI
# GENTUBE_VERBOSE=1
# Modelos por etapa (opcional; fallback CLAUDE_MODEL):
# GENTUBE_CLAUDE_MODEL_ROTEIRO=claude-opus-4-7
# GENTUBE_CLAUDE_MODEL_SEGMENTATION=claude-sonnet-4-6
# GENTUBE_CLAUDE_MODEL_VISUALIZATION=claude-sonnet-4-6
# Thinking: planos JSON usam disabled por defeito (GENTUBE_CLAUDE_THINKING_PLAN=disabled)
# GENTUBE_CLAUDE_THINKING_ROTEIRO=adaptive
# GENTUBE_CLAUDE_THINKING_PLAN=disabled

# max_scenes dinamico (blocos longos / 2 portas no mesmo blockNN.md):
# max_scenes = min(GENTUBE_MAX_SCENES_CAP, ceil(palavras / GENTUBE_MAX_SCENES_WORDS_DIVISOR))
# GENTUBE_MAX_SCENES_DYNAMIC=1
# GENTUBE_MAX_SCENES_WORDS_DIVISOR=18
# GENTUBE_MAX_SCENES_CAP=120
# GENTUBE_MAX_WORDS_PER_SCENE=120
# GENTUBE_VIZ_SPLIT_SCENE_THRESHOLD=70

# Prompt da etapa roteiro (ficheiro em Prompts/)
# GENTUBE_PROMPT_MATRIX=matriz.md
# GENTUBE_PROMPT_MATRIX=matriz_tutorial.md
# Modo sem ficheiro explicito: tutorial = Prompts/matriz_tutorial.md; omitir = matriz.md
# GENTUBE_ROTEIRO_MODE=tutorial

# Narracao (run-step --step narracao | retry --stage narracao)
# Cota: gentube elevenlabs:status
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Magnific (ex-Freepik) — stock footage e imagens para step imagens
MAGNIFIC_API_KEY=
# Pexels — fonte alternativa de stock (https://www.pexels.com/api/documentation/)
PEXELS_API_KEY=
# Provedor de stock no enqueue:
#   magnific | pexels | magnific_then_pexels | pexels_then_magnific
#   local_then_pexels_then_magnific
#   local_then_pexels_then_split
# GENTUBE_STOCK_PROVIDER=magnific_then_pexels
# Split para local_then_pexels_then_split (somente imagens sem avatar): X + Y = 100
# GENTUBE_STOCK_SPLIT_MAGNIFIC_PERCENT=60
# GENTUBE_STOCK_SPLIT_GOOGLE_BATCH_PERCENT=40
# Busca local aproximada (FTS + regressao progressiva)
# GENTUBE_STOCK_LIBRARY_FTS_MIN_SCORE=0.60
# GENTUBE_STOCK_LIBRARY_MIN_TERMS=3
# Proporcao de shots vindos do stock (0-100%; provedor conforme GENTUBE_STOCK_PROVIDER)
# GENTUBE_STOCK_RATIO_BLOCK1: bloco 1 (default: 50)
# GENTUBE_STOCK_RATIO_OTHER: blocos 2..N (default: 90)
GENTUBE_STOCK_RATIO_BLOCK1=50
GENTUBE_STOCK_RATIO_OTHER=90

# Step imagens — limite maximo de videos / imagens no plano (Claude + renders)
# Padroes: bloco 1 = 16 videos + 20 imagens; blocos 2..N = 10 videos + 40 imagens
# GENTUBE_MAX_VIDEOS_BLOCK1=16
# GENTUBE_MAX_IMAGES_BLOCK1=20
# GENTUBE_MAX_VIDEOS_OTHER_BLOCKS=10
# GENTUBE_MAX_IMAGES_OTHER_BLOCKS=40

# Roteiro — voz do canal (Markdown em Prompts/), injetado so no bloco 1
# GENTUBE_PROMPT_CANAL_VOICE=canal_voice.md
# GENTUBE_ROTEIRO_CANAL_VOICE=0

# Roteiro — texto dos blocos anteriores no prompt (coesao 2..N)
# GENTUBE_ROTEIRO_PREV_CONTEXT=1
# GENTUBE_ROTEIRO_PREV_CONTEXT_CHARS=100000

# Step imagens — plano por cenas (Claude segmenta01 + visualiza01)
# GENTUBE_SCENE_PLAN_V2=0
# Modalidade visual: default (comportamento atual) | wojak (avatar line-art — ver wojak.md)
# GENTUBE_VISUAL_MODALITY=default
# Stoic Patrol: stock 100% + quote_card (Hyperframes typing — render quote fase 2)
# GENTUBE_VISUAL_MODALITY=stoic_patrol
# GENTUBE_PROMPT_MATRIX=matriz_stoic_patrol.md
# GENTUBE_PROMPT_CANAL_VOICE=canal_voice_stoic_patrol.md
# GENTUBE_STOCK_RATIO_BLOCK1=100
# GENTUBE_STOCK_RATIO_OTHER=100
# GENTUBE_STOCK_PROVIDER=magnific_then_pexels
# PEXELS_API_KEY=...
# GENTUBE_QUOTE_RENDER=auto
# npm run gentube -- run-pipeline --project <slug> --profile stoic-patrol-stock --voice-id <id>
# npm run gentube -- quote:render --project <slug>
# Modo wojak v2: stock_ratio efetivo 0; plano so ai_generated + Wojak em todas as cenas; render so Gemini+Veo (sem Magnific stock / HF)
# Corrida recomendada com wojak (ver wojak.md):
# GENTUBE_VISUAL_MODALITY=wojak
# GENTUBE_IMAGE_BACKEND=gemini
# GENTUBE_VIDEO_BACKEND=veo
# GENTUBE_HF_ASYNC=0
# GENTUBE_SCENE_PLAN_V2=1
# Imagens estaticas em wojak: codigo forca google_batch (GENTUBE_IMAGE_DELIVERY abaixo aplica-se ao modo default)
# GENTUBE_IMAGE_DELIVERY=google_batch
# Prompt visualizacao: ficheiro em Prompts/ ou composicao visualiza01+visualiza_wojak se modality=wojak
# GENTUBE_PROMPT_VISUALIZA=visualiza_wojak.md
# GENTUBE_WOJAK_STYLE_TOKEN=
# Forca regerar segmentacao/visualizacao e apaga jobs HF do bloco no retry (ignora plano/.error no disco)
# GENTUBE_FORCE_VIZ_REGEN=0
# Veo: 0 = text-to-video sem PNG ref (prompt sanitizado); 1 = usa bootstrap como ref (pode falhar RAI)
# GENTUBE_WOJAK_VEO_USE_REF=0
# QualityGate — avalia roteiro antes de imagens (Sonnet; default ativo)
# GENTUBE_QUALITY_GATE_ENABLED=1
# GENTUBE_QUALITY_GATE_THRESHOLD=65
# GENTUBE_QUALITY_GATE_MAX_REGEN=1
# GENTUBE_CLAUDE_MODEL_QUALITY_GATE=claude-sonnet-4-6

# Roteiro: 1 Message Batch para todos os blocos pendentes (P4; contexto cruzado vazio na 1a corrida)
# GENTUBE_ROTEIRO_STAGE_BATCH=1

# Retry Claude apos quota/rate limit (ms)
# GENTUBE_QUOTA_RETRY_DELAY_MS=30000

# Daemon + fila job_queue (P8): gentube daemon:start · job:add --project <slug>
# GENTUBE_DAEMON_POLL_MS=10000

# Pipeline completo Wojak (roteiro → quality_gate → imagens → sync → narracao → montagem → thumbs):
# npm run gentube -- run-pipeline --project <slug> --voice-id <id>
# Background: gentube job:add --project <slug> --voice-id <id> && gentube daemon:start
# Rastreio: pipeline-report --project <slug> · 05 - Modelagem/pipeline-run-latest.json
# Retomada parcial se retry trava em Veo 429: npx tsx scripts/continue-missing-renders.ts --project <id> --block N
# Depois: npm run gentube -- image:sync --project <id> --watch
# cost-estimate (npm run gentube -- cost-estimate --project <id>):
# GENTUBE_COST_USD_CLAUDE_PLAN_BLOCK=4
# GENTUBE_COST_USD_GEMINI_IMAGE_SYNC=0.039
# GENTUBE_COST_USD_GEMINI_IMAGE_BATCH=0.0195
# GENTUBE_COST_USD_VEO_PER_SECOND=0.06

# Host SSH remoto para copy-cmd (evita --remote-host toda vez)
# GENTUBE_REMOTE_HOST=dev-development

# Step 3 (imagens/videos): use o CLI Higgsfield + credentials.json (nao exige as chaves abaixo).
# Opcional: HIGGSFIELD_CLI_PATH, HIGGSFIELD_CREDENTIALS_PATH, HIGGSFIELD_CLI_WAIT_TIMEOUT (ex.: 15m)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# --- Google GenAI (Gemini / Nano Banana) — imagens IA e thumbnails ---
# Chave API (SDK @google/genai le GEMINI_API_KEY; google_api_key e alias aceite no codigo)
GEMINI_API_KEY=
# google_api_key=
# Vertex / Batch API (opcional; batch Google)
# google_project_name=projects/SEU_NUMERO
# google_parent_folder_id=SEU_NUMERO

# Modelo de imagem (inline e batch)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image-preview

# Provedor de imagens: auto | higgsfield | gemini
# auto = HF primeiro; em falha (creditos, timeout, 5xx, etc.) tenta Gemini uma vez
GENTUBE_IMAGE_BACKEND=auto

# Entrega: sync | google_batch | local_batch
# Producao recomendada: google_batch (~50% custo vs inline, latencia maior)
GENTUBE_IMAGE_DELIVERY=google_batch

# Batch Google: um job por bloco no pipeline; CLI manual pode agrupar por projeto
# GENTUBE_GEMINI_BATCH_SCOPE=block

# Poll do batch Google e sync unificado (image:sync)
# GENTUBE_GEMINI_BATCH_POLL_INTERVAL=60s

# Batch local (testes): concorrencia maxima por processo
# GENTUBE_GEMINI_LOCAL_CONCURRENCY=4

# Aspect ratio e resolucao padrao (YouTube)
# GENTUBE_GEMINI_IMAGE_ASPECT_RATIO=16:9
# GENTUBE_GEMINI_IMAGE_SIZE=1K

# --- Veo (video IA) — fallback quando HF sem creditos ---
# CLI: gentube help video:retry · gentube video:status --project <id>
# auto = HF → Veo (poll sync) → Magnific | higgsfield | veo | magnific
# GENTUBE_VIDEO_BACKEND=auto
# GEMINI_VEO_MODEL=veo-3.1-lite-generate-preview
# GEMINI_VEO_RESOLUTION=1080p
# GENTUBE_VEO_DURATION_SECONDS=5
# GENTUBE_VEO_POLL_INTERVAL=15s
# GENTUBE_VEO_TIMEOUT=10m

# --- Step montagem (FFmpeg) — requer scene-plan-v2 + MP3 por cena ---
# GENTUBE_FFMPEG_PATH=
# GENTUBE_FFPROBE_PATH=
# GENTUBE_MONTAGEM_REQUIRE_SCENE_PLAN_V2=1
# Fase da montagem: full (padrao) | scenes (so clipes) | assemble (so blocos a partir dos clipes)
# GENTUBE_MONTAGEM_PHASE=full
# GENTUBE_MONTAGEM_DIR=06 - Montagem
# GENTUBE_MONTAGEM_SCENES_SUBDIR=scenes
# GENTUBE_MONTAGEM_BLOCKS_SUBDIR=blocks
# GENTUBE_MONTAGEM_WIDTH=1920
# GENTUBE_MONTAGEM_HEIGHT=1080
# GENTUBE_MONTAGEM_FPS=30
# GENTUBE_MONTAGEM_VIDEO_CODEC=libx264
# GENTUBE_MONTAGEM_VIDEO_PRESET=fast
# GENTUBE_MONTAGEM_VIDEO_CRF=23
# GENTUBE_MONTAGEM_AUDIO_CODEC=aac
# GENTUBE_MONTAGEM_AUDIO_BITRATE=192k
# GENTUBE_MONTAGEM_PIXEL_FORMAT=yuv420p
# GENTUBE_KEN_BURNS_MODE=zoom_in
# GENTUBE_KEN_BURNS_ZOOM_START=1.0
# GENTUBE_KEN_BURNS_ZOOM_END=1.12
# GENTUBE_KEN_BURNS_ZOOM_STEP=0.0004
# GENTUBE_KEN_BURNS_SCALE_WIDTH=3840
# GENTUBE_MONTAGEM_TRIM_RATIO=1.25
# GENTUBE_MONTAGEM_MAX_SPEED=2.0
# GENTUBE_MONTAGEM_LOOP_VIDEO=1
# GENTUBE_MONTAGEM_XFADE_DURATION=0.1
# GENTUBE_MONTAGEM_XFADE_TRANSITION=fade
# GENTUBE_MONTAGEM_AUDIO_CROSSFADE=1
# Concat bloco: single (1 ffmpeg, rapido) | pairwise (N-1 encodes, muito lento em blocos longos)
# GENTUBE_MONTAGEM_XFADE_CONCAT=single
# Acima de N cenas no bloco: divide em lotes single-pass e funde (evita OOM; ex. block06 com 80+ cenas)
# GENTUBE_MONTAGEM_XFADE_MAX_SCENES_SINGLE=40
# GENTUBE_MONTAGEM_PARTIAL_SEGMENTS=1
# GENTUBE_MONTAGEM_MIN_SCENES_PER_SEGMENT=1
# GENTUBE_MONTAGEM_STOP_ON_BLOCK_ERROR=0
# GENTUBE_MONTAGEM_WRITE_ERR_FILE=1
# GENTUBE_MONTAGEM_SKIP_EXISTING=1
# GENTUBE_MONTAGEM_MIN_MP3_BYTES=1024
# GENTUBE_MONTAGEM_VIDEO_EXTS=mp4,mov,webm
# GENTUBE_MONTAGEM_IMAGE_EXTS=png,jpg,jpeg,webp
