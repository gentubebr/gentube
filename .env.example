CLAUDE_API_KEY=
# Claude — modelo e comportamento (steps roteiro + imagens)
# CLAUDE_MODEL: modelo da API Anthropic (default: claude-opus-4-7)
# CLAUDE_MAX_TOKENS: limite de tokens de saida (default: 16000)
# CLAUDE_THINKING: adaptive (Opus 4.7), disabled (sem thinking, permite temperature), ou vazio (sem thinking)
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=16000
CLAUDE_THINKING=adaptive

# Prompt da etapa roteiro (ficheiro em Prompts/)
# GENTUBE_PROMPT_MATRIX=matriz.md
# GENTUBE_PROMPT_MATRIX=matriz_tutorial.md
# Modo sem ficheiro explicito: tutorial = Prompts/matriz_tutorial.md; omitir = matriz.md
# GENTUBE_ROTEIRO_MODE=tutorial

# Narracao (run-step --step narracao | retry --stage narracao)
# Cota: gentube elevenlabs:status
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Magnific (ex-Freepik) — stock footage e imagens para step imagens
MAGNIFIC_API_KEY=
# Proporcao de shots vindos do stock Magnific (0-100%)
# GENTUBE_STOCK_RATIO_BLOCK1: bloco 1 (default: 50)
# GENTUBE_STOCK_RATIO_OTHER: blocos 2..N (default: 90)
GENTUBE_STOCK_RATIO_BLOCK1=50
GENTUBE_STOCK_RATIO_OTHER=90

# Step imagens — limite maximo de videos / imagens no plano (Claude + renders)
# Padroes: bloco 1 = 16 videos + 20 imagens; blocos 2..N = 10 videos + 40 imagens
# GENTUBE_MAX_VIDEOS_BLOCK1=16
# GENTUBE_MAX_IMAGES_BLOCK1=20
# GENTUBE_MAX_VIDEOS_OTHER_BLOCKS=10
# GENTUBE_MAX_IMAGES_OTHER_BLOCKS=40

# Roteiro — voz do canal (Markdown em Prompts/), injetado so no bloco 1
# GENTUBE_PROMPT_CANAL_VOICE=canal_voice.md
# GENTUBE_ROTEIRO_CANAL_VOICE=0

# Roteiro — texto dos blocos anteriores no prompt (coesao 2..N)
# GENTUBE_ROTEIRO_PREV_CONTEXT=1
# GENTUBE_ROTEIRO_PREV_CONTEXT_CHARS=100000

# Step imagens — plano por cenas (Claude segmenta01 + visualiza01)
# GENTUBE_SCENE_PLAN_V2=0
# Forca regerar segmentacao/visualizacao e apaga jobs HF do bloco no retry (ignora plano/.error no disco)
# GENTUBE_FORCE_VIZ_REGEN=0

# Host SSH remoto para copy-cmd (evita --remote-host toda vez)
# GENTUBE_REMOTE_HOST=dev-development

# Step 3 (imagens/videos): use o CLI Higgsfield + credentials.json (nao exige as chaves abaixo).
# Opcional: HIGGSFIELD_CLI_PATH, HIGGSFIELD_CREDENTIALS_PATH, HIGGSFIELD_CLI_WAIT_TIMEOUT (ex.: 15m)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# --- Google GenAI (Gemini / Nano Banana) — imagens IA e thumbnails ---
# Chave API (SDK @google/genai le GEMINI_API_KEY; google_api_key e alias aceite no codigo)
GEMINI_API_KEY=
# google_api_key=
# Vertex / Batch API (opcional; batch Google)
# google_project_name=projects/SEU_NUMERO
# google_parent_folder_id=SEU_NUMERO

# Modelo de imagem (inline e batch)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image-preview

# Provedor de imagens: auto | higgsfield | gemini
# auto = HF primeiro; em falha (creditos, timeout, 5xx, etc.) tenta Gemini uma vez
GENTUBE_IMAGE_BACKEND=auto

# Entrega: sync | google_batch | local_batch
# Producao recomendada: google_batch (~50% custo vs inline, latencia maior)
GENTUBE_IMAGE_DELIVERY=google_batch

# Batch Google: um job por bloco no pipeline; CLI manual pode agrupar por projeto
# GENTUBE_GEMINI_BATCH_SCOPE=block

# Poll do batch Google e sync unificado (image:sync)
# GENTUBE_GEMINI_BATCH_POLL_INTERVAL=60s

# Batch local (testes): concorrencia maxima por processo
# GENTUBE_GEMINI_LOCAL_CONCURRENCY=4

# Aspect ratio e resolucao padrao (YouTube)
# GENTUBE_GEMINI_IMAGE_ASPECT_RATIO=16:9
# GENTUBE_GEMINI_IMAGE_SIZE=1K

# --- Veo (video IA) — fallback quando HF sem creditos ---
# CLI: gentube help video:retry · gentube video:status --project <id>
# auto = HF → Veo (poll sync) → Magnific | higgsfield | veo | magnific
# GENTUBE_VIDEO_BACKEND=auto
# GEMINI_VEO_MODEL=veo-3.1-lite-generate-preview
# GEMINI_VEO_RESOLUTION=1080p
# GENTUBE_VEO_DURATION_SECONDS=5
# GENTUBE_VEO_POLL_INTERVAL=15s
# GENTUBE_VEO_TIMEOUT=10m
